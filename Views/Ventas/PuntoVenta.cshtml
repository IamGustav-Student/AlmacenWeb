@model AlmacenWeb.ViewModels.PosViewModel
@using AlmacenWeb.Models
@{
    ViewData["Title"] = "Punto de Venta (Nuevo)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="bi bi-cart-plus-fill text-success"></i>
        Punto de Venta
    </h1>
    <form asp-action="CancelarVenta" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-lg btn-outline-danger"
                onclick="return confirm('¿Está seguro que desea vaciar el carrito?');">
            <i class="bi bi-x-circle-fill me-2"></i>
            Cancelar Venta
        </button>
    </form>
</div>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}


<div class="row g-4">

    <div class="col-lg-7">

        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">1. Agregar Producto</h5>
            </div>
            <div class="card-body">
                <form asp-action="AgregarAlCarrito" method="post" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-md-7">
                        <label asp-for="ProductoSeleccionadoId" class="form-label">Producto (con stock)</label>
                        <select asp-for="ProductoSeleccionadoId" class="form-select" asp-items="Model.ProductosDisponibles">
                            <option value="">-- Seleccionar un producto --</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Cantidad" class="form-label">Cantidad</label>
                        <input asp-for="Cantidad" class="form-control" type="number" />
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">2. Carrito Actual</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unit.</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Carrito)
                            {
                                <tr>
                                    <td>@item.Nombre</td>
                                    <td>@item.Cantidad</td>
                                    <td>@item.Precio.ToString("C")</td>
                                    <td>@item.Subtotal.ToString("C")</td>
                                    <td>
                                        <form asp-action="QuitarDelCarrito" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productoId" value="@item.ProductoId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Quitar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Carrito.Any())
                            {
                                <tr>
                                    <td colspan="5" class_text-center text-muted p-4">
                                        <i class="bi bi-cart-x fs-1"></i>
                                        <p class="mb-0">El carrito está vacío</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-group-divider fw-bold">
                            <tr>
                                <td colspan="3" class="text-end fs-5">Total:</td>
                                <td colspan="2" class="fs-5">@Model.TotalCarrito.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">3. Finalizar Venta</h5>
            </div>
            <div class="card-body">
                <form asp-action="RegistrarVenta" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="ClienteSeleccionadoId" class="form-label fw-bold">Cliente</label>
                        <select asp-for="ClienteSeleccionadoId" class="form-select" asp-items="Model.ClientesDisponibles">
                            <option value="">-- Seleccionar un cliente --</option>
                        </select>
                        <span asp-validation-for="ClienteSeleccionadoId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MetodoPagoSeleccionado" class="form-label fw-bold"></label>
                        <select asp-for="MetodoPagoSeleccionado" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()">
                            <option value="">-- Seleccionar método de pago --</option>
                        </select>
                        <span asp-validation-for="MetodoPagoSeleccionado" class="text-danger"></span>
                    </div>


                    <hr />

                    <div class="bg-light p-3 rounded d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">TOTAL A COBRAR:</h4>
                        <h4 class="mb-0 fw-bold text-success">@Model.TotalCarrito.ToString("C")</h4>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg"
                                @(Model.Carrito.Any() ? "" : "disabled")>
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Registrar Venta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}