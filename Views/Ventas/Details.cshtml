@model AlmacenWeb.Models.Venta
@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">Detalle de Venta #@Model.VeId</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>
        Volver al Historial
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h4>Resumen</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>Cliente:</strong>
                <p>@Model.Cliente.ClNombre @Model.Cliente.ClApellido (@Model.Cliente.ClDniCuit)</p>
            </div>
            <div class="col-md-4">
                <strong>Vendedor:</strong>
                <p>@Model.Usuario.UsNombre @Model.Usuario.UsApellido</p>
            </div>
            <div class="col-md-4">
                <strong>Fecha y Hora:</strong>
                <p>@Model.VeFecha.ToString("g")</p>
            </div>
        </div>
        <hr />
        <div class="text-end">
            <h3 class="mb-0">Total Pagado: <span class="text-success fw-bold">@Model.VeTotal.ToString("C")</span></h3>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h4>Productos Vendidos</h4>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.DetalleVentas)
                {
                    <tr>
                        <td>@detalle.Producto.PrNombre</td>
                        <td>@detalle.DeCantidad</td>
                        <td>@detalle.DePrecioUnitario.ToString("C")</td>
                        <td>@detalle.DeSubtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
