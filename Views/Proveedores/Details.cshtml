@model AlmacenWeb.Models.Proveedor

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-truck me-2"></i>
                    Detalles del Proveedor
                </h4>
                <a asp-action="Edit" asp-route-id="@Model.ProveedorId" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-1"></i>
                    Editar
                </a>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreEmpresa)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreEmpresa)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreContacto)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreContacto)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cuit)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Cuit)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Direccion)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefono)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefono)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
                </dl>
            </div>
            <div class="card-footer text-end">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Volver a la Lista
                </a>
            </div>
        </div>
    </div>
</div>
