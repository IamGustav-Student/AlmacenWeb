@model AlmacenWeb.Models.Proveedor

@{
    ViewData["Title"] = "Borrar Proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Confirmar Borrado
                </h4>
            </div>
            <div class="card-body">
                <h5 class="card-title">¿Estás seguro que deseas borrar este proveedor?</h5>
                <p>Esta acción no se puede deshacer.</p>

                <div class="bg-light-subtle p-3 rounded border">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreEmpresa)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreEmpresa)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cuit)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Cuit)</dd>
                    </dl>
                </div>

                <form asp-action="Delete" class="mt-3">
                    <input type="hidden" asp-for="ProveedorId" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg me-1"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-1"></i>
                            Borrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>