@model IEnumerable<AlmacenWeb.Models.Producto>

@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">
        <i class="bi bi-boxes text-primary"></i>
        Gestión de Productos
    </h1>
    <a asp-action="Create" class="btn btn-lg btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i>
        Nuevo Producto
    </a>
    <a asp-action="CargarStock" class="btn btn-lg btn-success">
        <i class="bi bi-upc-scan me-2"></i>
        Cargar por Scanner
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.PrNombre)</th>
                        <th>@Html.DisplayNameFor(model => model.CodigoBarra)</th>
                        <th>@Html.DisplayNameFor(model => model.Precio)</th>
                        <th>@Html.DisplayNameFor(model => model.CantidadDisponible)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.PrNombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.CodigoBarra)</td>
                            <td>@item.Precio.ToString("C")</td>
                            <td>@Html.DisplayFor(modelItem => item.CantidadDisponible)</td>

                            <td class="text-end" style="min-width: 190px;">
                                <a asp-action="Edit" asp-route-id="@item.PrId" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.PrId" class="btn btn-sm btn-outline-info" title="Detalles">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.PrId" class="btn btn-sm btn-outline-danger" title="Borrar">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
