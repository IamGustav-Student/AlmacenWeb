@model AlmacenWeb.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>
                    Editar Producto
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PrId" />

                    <div class="mb-3">
                        <label asp-for="PrNombre" class="form-label"></label>
                        <input asp-for="PrNombre" class="form-control" />
                        <span asp-validation-for="PrNombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CodigoBarra" class="form-label"></label>
                        <input asp-for="CodigoBarra" class="form-control" />
                        <span asp-validation-for="CodigoBarra" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CantidadDisponible" class="form-label"></label>
                            <input asp-for="CantidadDisponible" class="form-control" type="number" />
                            <span asp-validation-for="CantidadDisponible" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}