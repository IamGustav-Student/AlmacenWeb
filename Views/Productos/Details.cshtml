@model AlmacenWeb.Models.Producto

@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
	<div class="col-md-8">
		<div class="card shadow-sm">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h4 class="mb-0">
					<i class="bi bi-truck me-2"></i>
					Detalles del Producto
				</h4>
				<a asp-action="Edit" asp-route-id="@Model.PrId" class="btn btn-primary">
					<i class="bi bi-pencil-square me-1"></i>
					Editar
				</a>
			</div>
			<div class="card-body">
				<dl class="row">
					<dt class="col-sm-4">@Html.DisplayNameFor(model => model.PrNombre)</dt>
					<dd class="col-sm-8">@Html.DisplayFor(model => model.PrNombre)</dd>

					<dt class="col-sm-4">@Html.DisplayNameFor(model => model.CodigoBarra)</dt>
					<dd class="col-sm-8">@Html.DisplayFor(model => model.CodigoBarra)</dd>

					<dt class="col-sm-4">@Html.DisplayNameFor(model => model.Precio)</dt>
					<dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

					<dt class="col-sm-4">@Html.DisplayNameFor(model => model.CantidadDisponible)</dt>
					<dd class="col-sm-8">@Html.DisplayFor(model => model.CantidadDisponible)</dd>
				</dl>

			</div>
			<div class="" card-footer text-end">

				<a asp-action="Index" class="btn btn-outline-secondary">
					<i class="bi bi-arrow-left me-1"></i>
					Volver a la Lista
				</a>

			</div>

		</div>

	</div>

</div>
