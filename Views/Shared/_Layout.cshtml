<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlmacenWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlmacenWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AlmacenWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            // Roles de gestión de inventario: Admin, Dueño, Empleado
                            bool canManageInventory = User.IsInRole("Admin") || User.IsInRole("Dueño") || User.IsInRole("Empleado");

                            // Roles de administración de usuarios/roles: Admin
                            bool canManageUsers = User.IsInRole("Admin");

                            @* Menú Desplegable de Módulos Operativos (Inventario, Clientes, Ventas) *@
                            @if (canManageInventory)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarModulesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Operaciones
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarModulesDropdown">
                                        <li><h6 class="dropdown-header">Inventario</h6></li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Productos" asp-action="Index">Gestión de Productos</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Comercial</h6></li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Ventas" asp-action="PuntoVenta">Punto de Venta</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Clientes" asp-action="Index">Gestión de Clientes</a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @* Menú Desplegable de Administración (Usuarios, Roles) *@
                            @if (canManageUsers)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarAdminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Administración
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarAdminDropdown">
                                        <li><h6 class="dropdown-header">Seguridad y Personal</h6></li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Usuarios" asp-action="Index">Gestión de Usuarios</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Roles" asp-action="Index">Gestión de Roles</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="nav-item">
                                            <a class="dropdown-item" asp-area="" asp-controller="Proveedores" asp-action="Index">Gestión de Proveedores</a>
                                        </li>
                                    </ul>
                                </li>
                            }


                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            // Sección visible SOLO para usuarios logueados (Derecha del Nav - Perfil y Salir)
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    ¡Hola, @User.Identity.Name!
                                    @{
                                        string userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Invitado";
                                        string badgeClass = userRole == "Admin" ? "bg-danger" : (userRole == "Dueño" ? "bg-warning text-dark" : "bg-primary");
                                    }
                                    <span class="badge @badgeClass ms-1">@userRole</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#">Mi Perfil</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item text-dark" asp-area="" asp-controller="Acceso" asp-action="Salir">
                                            <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            // Sección visible SOLO para usuarios NO logueados
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Acceso" asp-action="Registrarse">Registrarse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Acceso" asp-action="Index">Iniciar Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AlmacenWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
