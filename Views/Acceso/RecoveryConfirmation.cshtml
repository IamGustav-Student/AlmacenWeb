@{
    ViewData["Title"] = "Revisa tu Email";
}

<div class="container register-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card register-card text-center">
                <div class="card-header bg-gradient text-white">
                    <h3 class="card-title text-center mb-0">¡Enviado!</h3>
                </div>
                <div class="card-body p-4">
                    <i class="bi bi-envelope-check-fill display-1 text-success"></i>
                    <h4 class="mt-3">Revisa tu bandeja de entrada</h4>
                    <p class="text-muted">
                        Si una cuenta con ese email existe en nuestro sistema,
                        hemos enviado un enlace para restablecer tu contraseña.
                    </p>
                    <p class="text-muted">
                        (El enlace expira en 1 hora)
                    </p>
                    <hr />
                    <a asp-action="Index" class="btn btn-primary">Volver a Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>
