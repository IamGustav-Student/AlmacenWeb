@{
    ViewData["Title"] = "Enlace Inválido";
    Layout = "_LayoutAcceso";
}

<div class="container register-container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card register-card text-center border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title text-center mb-0">Error</h3>
                </div>
                <div class="card-body p-4">
                    <i class="bi bi-x-octagon-fill display-1 text-danger"></i>
                    <h4 class="mt-3">Enlace Inválido o Expirado</h4>
                    <p class="text-muted">
                        El enlace de recuperación que utilizaste no es válido o ya ha expirado.
                        Por favor, solicita uno nuevo.
                    </p>
                    <hr />
                    <a asp-action="StartRecovery" class="btn btn-outline-primary">Solicitar Nuevo Enlace</a>
                </div>
            </div>
        </div>
    </div>
</div>
